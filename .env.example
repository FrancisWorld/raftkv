# raftkv reads its configuration from flags; these variables are only used by
# docker-compose.yml to override defaults. All values are placeholders.
RAFTKV_TICK=100ms
RAFTKV_SNAPSHOT_THRESHOLD=10000
RAFTKV_LOG_LEVEL=info
# The cluster key is deliberately absent: scripts/compose-up.sh generates a
# throwaway one per run. Never commit a real key.
# RAFTKV_CLUSTER_KEY=replace-me-with-32-or-more-random-characters
